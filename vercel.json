{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["lib/**/*.js"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/create-checkout-session",
      "dest": "/api/orders.js?action=checkout",
      "methods": ["POST", "OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "https://jornadadeinsights.com",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With",
        "Access-Control-Allow-Credentials": "true",
        "Content-Type": "application/json"
      }
    },
    {
      "src": "/api/create-donation-session",
      "dest": "/api/orders.js?action=donation",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/send-purchase-email",
      "dest": "/api/send-purchase-email.js",
      "methods": ["POST", "OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "https://jornadadeinsights.com",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With",
        "Access-Control-Allow-Credentials": "true",
        "Content-Type": "application/json"
      }
    },
    {
      "src": "/api/completed-orders",
      "dest": "/api/orders.js?action=completed",
      "methods": ["GET", "OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "https://jornadadeinsights.com",
        "Access-Control-Allow-Methods": "GET, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With",
        "Access-Control-Allow-Credentials": "true",
        "Content-Type": "application/json"
      }
    },
    {
      "src": "/api/orders-export",
      "dest": "/api/orders.js?action=export",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/my-orders",
      "dest": "/api/orders.js?action=mine",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/stats",
      "dest": "/api/analytics.js?action=stats",
      "methods": ["GET", "OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "https://jornadadeinsights.com",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With",
        "Access-Control-Allow-Credentials": "true",
        "Content-Type": "application/json"
      }
    },
    {
      "src": "/api/top-products",
      "dest": "/api/analytics.js?action=top-products",
      "methods": ["GET", "OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "https://jornadadeinsights.com",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With",
        "Access-Control-Allow-Credentials": "true",
        "Content-Type": "application/json"
      }
    },
    {
      "src": "/api/site-analytics-track",
      "dest": "/api/analytics.js?action=track",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/site-analytics-summary",
      "dest": "/api/analytics.js?action=summary",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/users",
      "dest": "/api/admin.js?action=users",
      "methods": ["GET", "DELETE", "OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "https://jornadadeinsights.com",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With",
        "Access-Control-Allow-Credentials": "true",
        "Content-Type": "application/json"
      }
    },
    {
      "src": "/api/admin-alerts",
      "dest": "/api/admin.js?action=alerts",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/admin-customer-lookup",
      "dest": "/api/admin.js?action=customer-lookup",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/notifications",
      "dest": "/api/notifications.js?action=list",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/notifications-mark-read",
      "dest": "/api/notifications.js?action=mark-read",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/notifications-cron",
      "dest": "/api/notifications.js?action=cron-check",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/lifecycle-event-track",
      "dest": "/api/lifecycle.js?action=track",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/lifecycle-followup-jobs",
      "dest": "/api/lifecycle.js?action=followup-jobs",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/lifecycle-funnel-summary",
      "dest": "/api/lifecycle.js?action=funnel-summary",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/health",
      "dest": "/api/ops.js?action=health",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/lifecycle-followup-runner",
      "dest": "/api/ops.js?action=followup-runner",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js",
      "methods": ["GET", "POST", "DELETE", "OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "https://jornadadeinsights.com",
        "Access-Control-Allow-Methods": "GET, POST, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With",
        "Access-Control-Allow-Credentials": "true",
        "Content-Type": "application/json"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/notifications-cron",
      "schedule": "0 */6 * * *"
    }
  ]
} 